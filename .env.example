# Environment Configuration

# ===== REQUIRED =====
# OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=sk_live_your_key_here

# ===== OPTIONAL: Alpha Vantage (Technical Indicators) =====
# Get free API key at https://www.alphavantage.co
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ===== OPTIONAL: Discord Bot =====
# Create bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=123456789012345678

# ===== OPTIONAL: Slack Bot =====
# Create bot at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL_ID=C0123456789

# ===== OPTIONAL: Application Settings =====
# App URL for OpenRouter referer header
APP_URL=http://localhost:3000
APP_TITLE=Stock Analysis CLI

# Stock tickers for daily reports (comma-separated)
STOCK_TICKERS=AAPL,MSFT,TSLA,AMD
